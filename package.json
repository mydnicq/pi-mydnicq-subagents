{
  "name": "pi-mydnicq-subagents",
  "version": "0.0.1",
  "description": "Pi extension for delegating tasks to subagents",
  "type": "module",
  "license": "MIT",
  "author": "tadejstanic",
  "repository": {
    "type": "git",
